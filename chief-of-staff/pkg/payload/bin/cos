#!/usr/bin/env python3
"""Chief-of-staff state CLI. Run from the workspace root: bin/cos --help"""
import os
import sys

if sys.version_info < (3, 9):
    sys.stderr.write("cos needs Python 3.9 or newer (found %s). See docs/INSTALL.md.\n" % sys.version.split()[0])
    sys.exit(1)

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "lib"))
sys.dont_write_bytecode = True

from cos.cli import main  # noqa: E402

sys.exit(main())
